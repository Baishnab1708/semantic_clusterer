# =============================================================================
# Environment Variables Template for semantic_clusterer
# =============================================================================
# Copy this file to .env and fill in your credentials if using remote APIs:
#   cp .env.example .env
# =============================================================================

# --- OpenAI API Configuration (Optional: for OpenAI embeddings / LLMs) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=text-embedding-3-small

# --- Azure OpenAI Configuration (Optional: for Azure OpenAI embeddings) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Qdrant Vector DB (Optional: for external vector store workflows) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=
